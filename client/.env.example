# Base URL of the backend API.
# - Local dev:    http://localhost:4000
# - Phase A test: http://<ec2-elastic-ip>:4000
# - Production:   https://api.yourdomain.com
#
# Note: this is baked into the build at compile time (Vite). Changing it
# requires a rebuild. Vite ships VITE_* vars to the browser bundle — do
# not put secrets here.
VITE_API_BASE_URL=http://localhost:4000
