# Port the Express server listens on
PORT=4000

# Postgres connection string (Neon, Supabase, local, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Comma-separated list of allowed CORS origins.
# Add every URL your frontend will be served from — local dev, Vercel preview, prod.
FRONTEND_URLS=http://localhost:5173

# Secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string

# Redis connection (for BullMQ + rate limiters).
# In docker-compose, REDIS_HOST=redis (the service name).
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Gemini API key (for AI code review).
GEMINI_API_KEY=your-gemini-api-key
